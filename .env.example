# =============================================================================
# ForgeMind AI — Environment Variables Template (.env.example)
# Safe for Version Control — DO NOT PLACE REAL SECRETS OR KEYS HERE
# =============================================================================

# Backend API & Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_URL=postgresql+psycopg2://forgemind_user:password@localhost:5432/forgemind
ALLOWED_ORIGINS=*

# Frontend API Base URL (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Google Firebase Project Credentials Template (Obtain from Firebase Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
