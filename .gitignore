# =============================================================================
# ForgeMind AI — Comprehensive .gitignore
# Python / FastAPI + React / TypeScript / Vite + ML + Secrets
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (Ignored in all root and nested subdirectories)
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!**/.env.example
!**/.env.template
*.secret
*.pem
*.key
*.pfx
*.p12
credentials.json
service-account*.json
firebase-key*.json

# -----------------------------------------------------------------------------
# Python & Virtual Environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & Packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Testing & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
.hypothesis/
.tox/

# Type Checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Node.js / React / Vite Frontend
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.vite/
**/dist/
**/build/
.next/
out/
.nuxt/
.output/

# -----------------------------------------------------------------------------
# Databases & Local Storage
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.dump
*.sql

# -----------------------------------------------------------------------------
# Machine Learning — Model Checkpoints & Weights
# -----------------------------------------------------------------------------
models/checkpoints/
models/weights/
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.joblib
*.h5
*.hdf5
*.pb
*.tflite
*.safetensors

# MLflow / Experiment Tracking
mlruns/
mlartifacts/

# -----------------------------------------------------------------------------
# Dataset Caches & Temporary Processing Files
# -----------------------------------------------------------------------------
dataset/
data/cache/
data/raw/
data/interim/
data/processed/
*.parquet
*.feather
*.arrow

# -----------------------------------------------------------------------------
# Logs & Temporary Workspace Files
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
temp/
tmp/
.gemini/

# -----------------------------------------------------------------------------
# IDE & System Files
# -----------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.netrwhist
\#*\#
.\#*
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Reports & Profiling Outputs
# -----------------------------------------------------------------------------
output/
reports/generated/
*.prof
*.lprof
